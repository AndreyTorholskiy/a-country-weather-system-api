<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<sub-flow name="getWeather" doc:id="7386fda6-cee8-4e27-bcbe-3996a5ae01d4" >
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	message: "Get Weather from OpenWeather"&#10;}]' doc:name="logMessage - Flow Start" doc:id="2f0f528d-498f-4a0b-ad69-bad4f600bc6c" variableName="logMessage"/>
		<flow-ref doc:name="auditLogging" doc:id="dd685c4d-c3e1-48e2-8efe-f41a10377576" name="auditLogging" />
		<http:request doc:name="Call OpenWeather" doc:id="90191347-b08e-43ba-8fc0-d57f0d743f13" config-ref="OpenWeather_Request_configuration" path="/weather">
			<reconnect frequency="10000" />
			<http:query-params ><![CDATA[#[output application/json
---
{
	"q" : attributes.queryParams.city,
	"units" : "metric"
}]]]></http:query-params>
		</http:request>
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;var city = payload.name&#10;---&#10;{&#10;    message: "Get Weather: weather retrieved",&#10;    requestedCityWeather: city&#10;}]' doc:name="logMessage - API Response" doc:id="45999ead-6152-47ae-ad4a-0d46ea821b38" variableName="logMessage"/>
	</sub-flow>
	<sub-flow name="getCountry" doc:id="f05f4486-0c7e-4436-9dce-88e8325274aa" >
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	message: "Get Country from RESTCountries"&#10;}]' doc:name="logMessage - Flow Start" doc:id="10c47382-ac13-491f-be29-046be34f3b2a" variableName="logMessage" />
		<flow-ref doc:name="auditLogging" doc:id="8a7db7b6-b82a-4fa2-861c-72e98cdbe99e" name="auditLogging" />
		<ee:cache doc:name="Cache" doc:id="95e30a0e-a467-4445-af81-f9cdaf3c982e" cachingStrategy-ref="Country_Caching_Strategy">
			<http:request doc:name="Call RESTCountries" doc:id="efdf73d9-fc16-4de5-897a-59e364cc405f" config-ref="RESTCountries_Request_configuration" path="/region/europe">
			<reconnect frequency="10000" />
			<http:query-params><![CDATA[#[output application/java
---
{
	"fields" : "name,capital,currencies,region,subregion,languages,population,cca2"
}]]]></http:query-params>
		</http:request>
		</ee:cache>
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;var countryCount = sizeOf(payload)&#10;---&#10;{&#10;    message: "Get Country: countries retrieved",&#10;    fetchedRecords: countryCount&#10;}]' doc:name="logMessage - API Response" doc:id="94a0f4fa-e755-45ab-b0a8-697b228c0930" variableName="logMessage" />
	</sub-flow>
</mule>
