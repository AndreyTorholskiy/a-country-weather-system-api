#%RAML 1.0 DataType
displayName: Weather Data
description: Standard weather object retrieved from External API

type: object
properties:
  coord:
    displayName: Coordinates
    description: Geographical coordinates of the location (longitude and latitude)
    type: object
    required: true
    properties:
      lon: 
        type: number
      lat: 
        type: number  
  weather:
    displayName: Weather type
    description: Weather array
    type: array
    items:
      type: object
      properties:
        id: 
          type: integer
          description: Unique ID of weather
        main: 
          type: string
          description: Group of weather conditions
        description: 
          type: string
        icon: 
          type: string
  base: 
    displayName: Base Parameter
    description: Inner parameter of an API 
    type: string
    required: false
  main:
    displayName: Main metrics
    description: Main metrics (temp, pressure, humidity)
    type: object
    properties:
      temp: 
        type: number
      feels_like: 
        type: number
      temp_min: 
        type: number
      temp_max: 
        type: number
      pressure: 
        type: number
      humidity: 
        type: number
      sea_level:
        type: number
        required: false
      grnd_level:
        type: number
        required: false
  visibility: 
    displayName: Visibility
    description: Average visibility in meters
    type: integer
    required: false
  wind:
    displayName: Wind
    description: Wind information
    type: object
    properties:
      speed: 
        type: number
      deg: 
        type: number
      gust:
        type: number
        required: false
  clouds:
    displayName: Clouds
    description: Clouds information
    type: object
    properties:
      all: 
        type: integer
  precipitation:
    displayName: Precipitation
    description: Weather precipitation for last and third hour
    type: object
    required: false
    properties:
      "1h":
        type: number
        required: false
      "3h":
        type: number
        required: false
  dt: 
    displayName: Timestamp
    description: UNIX timestamp
    type: integer
  sys:
    displayName: System information
    description: Inner system information
    type: object
    properties:
      type: 
        type: integer
        required: false
      id: 
        type: integer
        required: false
      country: 
        type: string
        description: Country code
      sunrise: 
        type: integer
      sunset: 
        type: integer
  timezone: 
    displayName: Time zone
    description: Time shift from UTC
    type: integer
  id: 
    displayName: City ID
    description: Unique city ID
    type: integer
  name: 
    displayName: City name
    description: Name of the city
    type: string
  cod: 
    displayName: Code
    description: Response code
    type: integer